function allQuestions_(){let a=[];allSurveys_().forEach(s=>a=a.concat(questions_(s.SurveyId)));return a}
function allSurveys_(){return data_(CFG.S.SUR)}
function surveyCode_(c){return allSurveys_().find(x=>String(x.Code).trim()===String(c).trim())||null}
