function answers_(rid){let o={};data_(CFG.S.ANS).filter(r=>String(r.ResponseId)===String(rid)).forEach(r=>{if(r.ValueJson){o[r.QuestionId]=tryJson_(r.ValueJson)}else if(r.ValueNumber!=='')o[r.QuestionId]=r.ValueNumber;else if(r.ValueDate!=='')o[r.QuestionId]=dateISO_(r.ValueDate);else o[r.QuestionId]=r.ValueText||''});return o}
function replaceAnswers_(rid,sid,qs,a,now){let sh=sh_(CFG.S.ANS),h=map_(sh),rows=sh.getDataRange().getValues(),keep=[rows[0]];for(let i=1;i<rows.length;i++)if(String(rows[i][h.ResponseId])!==String(rid))keep.push(rows[i]);sh.clearContents();sh.getRange(1,1,keep.length,keep[0].length).setValues(keep);let out=[];qs.forEach(q=>{let v=a[q.QuestionId];if(empty_(v))return;let row=new Array(Object.keys(h).length).fill('');row[h.AnswerId]='ANS_'+uuid_();row[h.ResponseId]=rid;row[h.SurveyId]=sid;row[h.QuestionId]=q.QuestionId;row[h.FieldKey]=q.FieldKey;if(Array.isArray(v))row[h.ValueJson]=JSON.stringify(v);else if(q.Type==='number'&&isFinite(Number(v)))row[h.ValueNumber]=Number(v);else if(['date','datetime'].includes(q.Type)&&v)row[h.ValueDate]=new Date(v);else row[h.ValueText]=String(v).slice(0,5000);row[h.UpdatedAt]=now;out.push(row)});if(out.length)sh.getRange(sh.getLastRow()+1,1,out.length,Object.keys(h).length).setValues(out)}
function employees_(){let c=CacheService.getScriptCache(),x=c.get('emp3');if(x)try{return JSON.parse(x)}catch(e){}let sh=sh_(CFG.EMP),v=sh.getDataRange().getDisplayValues(),h=employeeMap_(v[0]),a=v.slice(1).map(r=>({MaNV:r[h.MaNV]||'',HoTen:r[h.HoTen]||'',CCCD:norm_(r[h.CCCD])})).filter(x=>x.MaNV||x.HoTen||x.CCCD);c.put('emp3',JSON.stringify(a),300);return a}
function employeeMap_(a){let h={};a.forEach((v,i)=>h[String(v).trim()]=i);if(h.MaNV===undefined)h.MaNV=h['Mã NV'];if(h.HoTen===undefined)h.HoTen=h['Họ tên']??h['Họ và tên'];if(h.CCCD===undefined)h.CCCD=h['Số CCCD']??h['CCCD'];if([h.MaNV,h.HoTen,h.CCCD].some(x=>x===undefined))throw Error('DSCNV cần MaNV, HoTen, CCCD');return h}
