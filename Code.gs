function ss_(){let id=PropertiesService.getScriptProperties().getProperty(CFG.ID);if(!id)throw Error('Chưa cấu hình SPREADSHEET_ID trong Script Properties.');return SpreadsheetApp.openById(id)}
function sh_(n){let s=ss_().getSheetByName(n);if(!s)throw Error('Thiếu sheet '+n+'. Hãy chạy setupSystem().');return s}
function ensure(ss,n,h){let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0)s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1)}function map_(s){let a=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0],o={};a.forEach((v,i)=>{if(v)o[v]=i});return o}function find_(s,c,v){let n=s.getLastRow()-1;if(n<1)return-1;let a=s.getRange(2,c+1,n,1).getDisplayValues();for(let i=0;i<a.length;i++)if(String(a[i][0])===String(v))return i+2;return-1}
function upsert_(sn,o,key,val){let s=sh_(sn),h=map_(s),r=find_(s,h[key],val);if(r<2)r=s.getLastRow()+1;let a=new Array(Object.keys(h).length).fill('');Object.keys(o).forEach(k=>{if(h[k]!==undefined)a[h[k]]=o[k]});s.getRange(r,1,1,a.length).setValues([a])}
function replaceOptions_(qid,arr,now){let s=sh_(CFG.S.OPT),h=map_(s),v=s.getDataRange().getValues(),keep=[v[0]];for(let i=1;i<v.length;i++)if(String(v[i][h.QuestionId])!==String(qid))keep.push(v[i]);s.clearContents();s.getRange(1,1,keep.length,keep[0].length).setValues(keep);let a=arr.map((o,i)=>['OPT_'+uuid_(),qid,typeof o==='object'?o.Value:o,typeof o==='object'?(o.Label||o.Value):o,i+1,true,now]);if(a.length)s.getRange(s.getLastRow()+1,1,a.length,7).setValues(a)}
function pub_(s){return {SurveyId:s.SurveyId,Code:s.Code,Name:s.Name,Title:s.Title,Description:s.Description,WelcomeText:s.WelcomeText,ConsentText:s.ConsentText,Status:s.Status,StartAt:dateISO_(s.StartAt),EndAt:dateISO_(s.EndAt),Version:+s.Version||1}}
function active_(v){return v===true||String(v).toLowerCase()==='true'||String(v)==='1'}function window_(s){let n=Date.now(),a=date_(s.StartAt),b=date_(s.EndAt);return(!a||n>=a)&&(!b||n<=b)}function empty_(v){return Array.isArray(v)?v.length===0:String(v??'').trim()===''}function norm_(v){return String(v??'').replace(/\D/g,'').slice(0,12)}function mask_(v){let s=norm_(v);return s.length>4?'*'.repeat(s.length-4)+s.slice(-4):'*'.repeat(s.length)}function date_(v){let d=v instanceof Date?v:new Date(v);return isNaN(d)?0:d.getTime()}function dateISO_(v){if(!v)return'';let d=v instanceof Date?v:new Date(v);return isNaN(d)?String(v):d.toISOString()}function fmt_(v){return dateISO_(v)}function err(e){return String(e&&e.message||e).slice(0,700)}function uuid_(){return Utilities.getUuid().slice(0,8).toUpperCase()}function hex_(n){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,Utilities.getUuid()+Math.random()).map(x=>('0'+(x<0?x+256:x).toString(16)).slice(-2)).join('').slice(0,n)}function hash_(p,s){let pepper=PropertiesService.getScriptProperties().getProperty(CFG.PEPPER)||'';return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,p+':'+s+':'+pepper).map(x=>('0'+(x<0?x+256:x).toString(16)).slice(-2)).join('')}function eq_(a,b){return String(a)===String(b)}function tryJson_(x){try{return x?JSON.parse(x):{}}catch(e){return {}}}function slug_(s){return String(s||'field').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'').slice(0,80)||'field'}function csv(v){return '"'+String(v??'').replace(/"/g,'""')+'"'}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}function audit_(a,b,c,d,e,f){try{sh_(CFG.S.AUD).appendRow([Utilities.getUuid(),new Date(),a,b,c,d,e,JSON.stringify(f||{})])}catch(x){}}
