function adminSetSurveyStatus(b){let u=auth_(b.token),s=surveyCode_(b.code);if(!u)return unauth_();if(!s)return {ok:false};let st=String(b.status||'').toUpperCase();if(!['DRAFT','PUBLISHED','CLOSED','ARCHIVED'].includes(st))return {ok:false,error:'INVALID_STATUS'};let h=map_(sh_(CFG.SUR));sh_(CFG.SUR).getRange(s._row,h.Status+1).setValue(st);return {ok:true}}
